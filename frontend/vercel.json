{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/content-library.html"
    },
    {
      "source": "/dashboard",
      "destination": "/content-library.html"
    },
    {
      "source": "/home",
      "destination": "/content-library.html"
    },
    {
      "source": "/content",
      "destination": "/content-library.html"
    },
    {
      "source": "/trends",
      "destination": "/content-library.html"
    },
    {
      "source": "/ideas",
      "destination": "/content-library.html"
    },
    {
      "source": "/reports",
      "destination": "/content-library.html"
    },
    {
      "source": "/notebook",
      "destination": "/content-library.html"
    }
  ]
}
